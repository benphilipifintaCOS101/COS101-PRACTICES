// Method to print the get value
fn value(n:Option<&char>)
{
    println!("Element of vector (:?)",n);
}

fn main() {

    Let v = vec!['R','U','S','T','A','C','I','A','N'];

    Let mut input1 = String: :new();
    println!("\nEnter an index value btw (0 - 8)");

    //index is the the non negative value that is smaller than the size of the vector
    Let index:usize = input1.trim().parse().except("Invalid input");

    //getting value at given index value
    Let ch: Option<&char> = v.get(index);
    value(ch)
}